# Sanity CMS Configuration
# Get these values from https://sanity.io/manage

# Your Sanity Project ID (required)
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id_here

# Your Sanity Dataset (default: production)
NEXT_PUBLIC_SANITY_DATASET=production

# Sanity API Token (required for write operations)
# Create a token at: https://sanity.io/manage/personal/tokens
SANITY_API_TOKEN=your_api_token_here
